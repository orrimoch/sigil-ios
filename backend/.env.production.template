# Sigil Backend - Production Environment Variables
# Copy to .env and fill in values

# =============================================================================
# REQUIRED
# =============================================================================

# Authentication
AUTH_REQUIRED=true
JWT_SECRET_KEY=<generate-with: openssl rand -hex 32>

# Database
DATABASE_URL=postgresql://user:password@host:5432/sigil

# IBKR (if using live trading)
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4001
IB_ACCOUNT_ID=<your-account-id>

# =============================================================================
# API KEYS
# =============================================================================

# Anthropic (for AI scoring and agent)
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# OPTIONAL
# =============================================================================

# Push Notifications (APNs)
APNS_KEY_ID=<key-id-from-apple>
APNS_TEAM_ID=<team-id>
APNS_KEY_PATH=/path/to/AuthKey.p8
APNS_BUNDLE_ID=com.sigil.ios

# Email (for password reset)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=<sendgrid-api-key>
SMTP_FROM=noreply@sigil.app

# Error Tracking
SENTRY_DSN=https://...@sentry.io/...

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
ENABLE_LIVE_TRADING=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_AGENT=true
AGENT_MODE=supervised

# =============================================================================
# CORS (update for your domain)
# =============================================================================

CORS_ORIGINS=https://sigil.app,https://api.sigil.app
