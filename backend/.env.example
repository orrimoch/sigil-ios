# Sigil Backend Configuration (REC-272)
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Choose your LLM provider: anthropic | openai | google
LLM_PROVIDER=anthropic

# Provider-specific API keys (only set the one for your chosen provider)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key

# Model selection (optional - uses provider defaults if not set)
# Anthropic: claude-sonnet-4-20250514, claude-3-5-haiku-20241022, claude-opus-4-20250514
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, o1, o1-mini
# Google: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
LLM_MODEL=claude-sonnet-4-20250514

# LLM settings
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_RATE_LIMIT=50
LLM_MAX_RETRIES=3
LLM_MAX_DAILY_SPEND=10.0

# =============================================================================
# Database Configuration
# =============================================================================

# Option 1: Full database URL (takes precedence)
# For Railway PostgreSQL, this is auto-set
# DATABASE_URL=postgres://user:password@host:5432/database

# Option 2: Individual PostgreSQL components
# DATABASE_TYPE=postgresql
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-password
# PGDATABASE=sigil

# Option 3: SQLite (default for development)
# DATABASE_TYPE=sqlite
# (Uses backend/data/sigil.db automatically)

# PostgreSQL pool settings (only used with PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Enable SQL query logging (for debugging)
SQL_ECHO=false

# =============================================================================
# IBKR Configuration
# =============================================================================

# Your Interactive Brokers account ID
# Paper accounts start with DU, live accounts start with U
# DO NOT SET A DEFAULT - each user should configure their own
IB_ACCOUNT_ID=

# IB Gateway connection settings
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002

# Daily loss limit (percentage of portfolio)
DAILY_LOSS_LIMIT_PERCENT=5.0

# =============================================================================
# Authentication
# =============================================================================

# JWT secret key (generate a secure random string)
JWT_SECRET_KEY=your-super-secret-key-change-this

# Require authentication for API endpoints (production = true)
AUTH_REQUIRED=true

# =============================================================================
# Environment
# =============================================================================

# Environment name: development | staging | production
ENVIRONMENT=development

# =============================================================================
# Sentiment Analysis (Legacy - now uses LLM_PROVIDER)
# =============================================================================

# These are still supported for backward compatibility
SENTIMENT_MODEL=keyword
SENTIMENT_CACHE_TTL=24
SENTIMENT_RATE_LIMIT=50
SENTIMENT_MAX_ARTICLES=10
SENTIMENT_MAX_DAILY_SPEND=10.0
