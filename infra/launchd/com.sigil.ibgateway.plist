<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sigil.ibgateway</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>hdiutil attach /tmp/ibgateway_volume.sparseimage 2>/dev/null; cd /Users/blazeneon/ibc &amp;&amp; ./gatewaystartmacos.sh -inline</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/tmp/ibgateway_launchd.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/ibgateway_launchd_error.log</string>
    
    <key>WorkingDirectory</key>
    <string>/Users/blazeneon/ibc</string>
    
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
