# Sigil Backend Environment Configuration
# Copy this to .env and fill in your values

# === Application ===
ENVIRONMENT=development      # development | staging | production
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# === Authentication ===
AUTH_REQUIRED=false         # Set to true in production
JWT_SECRET=                 # Generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Database ===
DATABASE_URL=sqlite:///./data/sigil.db

# === External APIs ===
ANTHROPIC_API_KEY=          # For AI risk analysis (Claude)

# === IBKR Integration ===
IBKR_HOST=127.0.0.1
IBKR_PORT=4002              # 4001=live, 4002=paper
IBKR_CLIENT_ID=1

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60        # seconds

# === CORS ===
CORS_ORIGINS=["http://localhost:3000"]  # Add your frontend URLs

# === Optional Features ===
ENABLE_METRICS=false
ENABLE_DOCS=true            # Swagger/OpenAPI docs at /docs
